nervessyspr() {
  targets=(rpi rpi0 rpi2 rpi3 rpi3a rpi4 rpi5 osd32mp1 bbb vultr x86_64 grisp2 mangopi_mq_pro srhub qemu_aarch64)
  branch=$1

  if [[ -z "$branch" ]]; then
    branch=br-bump
  fi

  echo "Checking system updates on $branch"

  for t in ${targets[@]}; do
    case $t in
      srhub)
        repo=smartrent/nerves_system_$t
      ;;
      *)
        repo=nerves-project/nerves_system_$t
      ;;
    esac
    pr=`gh pr list -R $repo | grep -E "$branch" | awk '{print $1}'`
    if [[ ! -z "$pr" ]]; then
      echo -e "\n\033[33m----- Checks -----\033[0m\n"
      gh pr checks -R $repo $pr
      echo -e "\n\033[33m----- Diff -----\033[0m\n"
      gh pr diff -R $repo $pr
      echo -e "\n\033[33m----- Review -----\033[0m\n"
      gh pr review -R $repo $pr --body ""
    fi
  done
}

hacktoberfest() {
  case $1 in
    start)
      action=add
      ;;
    end)
      action=remove
      ;;
    *)
      echo "Must specify start or end"
      return 1
      ;;
  esac

  orgs=(nerves-project nerves-time nerves-networking nerves-hub)

  for org in ${orgs[@]}; do
    req=$(gh repo list $org --json name --jq '.[].name')
    echo ${req//\"/""} | while read project; do
      gh repo edit "$org/$project" --$action-topic hacktoberfest
    done
  done
}

nervesdependabot() {
  req=`gh api --paginate -X GET search/issues -f q='org:nerves-project org:nerves-time org:nerves-networking is:open is:pull-request label:dependencies' | jq -c '.items[] | .pull_request.html_url'`

  fails=()

  echo ${req//\"/""} | while read pr; do
    c=$(gh pr checks $pr)

    if [ $? -eq 0 ]; then
      echo "$pr"
      gh pr merge $pr --rebase --delete-branch
    else
      fails+=($pr)
    fi
  done

  for pr in ${fails[@]}; do
    echo "\n\033[0;33m$pr\033[0m"
    gh pr checks $pr
  done
}

