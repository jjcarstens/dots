bump-ver() {
  if [[ ! -f "VERSION" ]]; then
    echo "ERROR: VERSION file does not exist."
    echo "A VERSION file is required in the root folder of the current repository for this script to function properly. (Where the .git folder is located)"
    return 1
  fi
  version=$(<VERSION)
  IFS='.' read -r major minor patch <<< "${version}"
  IFS='.' read -r ver <<< "${version}"

  if [[ -z "$step" ]]; then
    step=1
  fi

  for opt in "$@"; do
    case "$opt" in
      step*)
        step=${opt##*:}
      ;;
      *)
      ;;
    esac
  done

  for opt in "$@"; do
    case "$opt" in
      major)
      ((major+=step))
      minor=0
      patch=0
      break
      ;;
      minor)
      ((minor+=step))
      patch=0
      break
      ;;
      patch | hotfix)
      ((patch+=step))
      break
      ;;
      *)
      ;;
    esac
  done
  next_version="${major}.${minor}.${patch}"
  if [[ "$version" == "$next_version" ]]; then
    echo "Version did not change!"
    echo "Must supply major, minor, or patch option"
    return 1
  fi
  echo "$next_version" > VERSION
}

logsincelast() {
  if [[ -z "$1" ]]; then
    echo "must supply a repo under ~/repos"
    return 1
  fi
  repo=~/repos/$1
  if [[ ! -d "$repo" ]]; then
    echo "repo does not exist"
    return 1
  fi

  if [[ -z "$2" ]]; then
    if [[ -f "$repo/VERSION" ]]; then
      ver=v$(cat "$repo/VERSION")
    else
      echo "must supply current version"
      return 1
    fi
  else
    ver=$2
  fi

  if [[ -z "$3" ]]; then
    base=main
  else
    base=$3
  fi

  # Print one line and exclude dependabot PR noise
  git -C $repo log --oneline --invert-grep --grep="Bump .* from .* to .* in" $ver...$base
}

# --- dots: sync/pull the public dotfiles AND the private overlay together -----
dots() {
  emulate -L zsh
  local msg="${2:-dots sync}"
  case "$1" in
    sync)
      echo "→ public dotfiles"
      chezmoi re-add
      chezmoi git -- add -A
      chezmoi git -- commit -m "$msg" 2>/dev/null
      chezmoi git -- push
      echo "→ private overlays"
      git -C ~/.dots-private add -A
      git -C ~/.dots-private commit -m "$msg" 2>/dev/null
      git -C ~/.dots-private push
      ;;
    update)
      chezmoi update
      git -C ~/.dots-private pull --ff-only
      ;;
    *)
      echo "usage: dots [sync|update]  (public dotfiles + private overlays)"
      ;;
  esac
}

# Machine/employer-specific overlay from the private repo (github.com/jjcarstens/dots-private).
