# Homebrew manifest — kept intentionally small.
#
# Philosophy: mise-first for CLIs/runtimes; Homebrew only for (a) build/system
# deps that mise can't provide and (b) GUI apps whose cask is official + self-
# updating. Every cask below was vetted to pull from the vendor's official URL.
#
# Install:  brew bundle --file ~/.local/share/chezmoi/install/Brewfile
# Update :  brew upgrade            (HOMEBREW_NO_AUTO_UPDATE=1 stops surprise churn;
#                                    most GUI apps self-update, so this is rare)

# --- Taps --------------------------------------------------------------------
tap "nvie/tap"

# --- CLIs & build/system deps ------------------------------------------------
# Build deps for Erlang/Nerves/fwup toolchains + CLIs without a good mise backend.
# Prefer `mise use -g <tool>` for any NEW cli before adding it here.
brew "automake"           # build dep
brew "confuse"            # build dep (nerves)
brew "libarchive"         # build dep
brew "pkgconf"            # build dep
brew "squashfs"           # build dep (nerves/fwup)
brew "coreutils"          # GNU coreutils
brew "cloudflared"        # Cloudflare Tunnel (used by ssh ProxyCommand)
brew "nmap"
brew "tio"                # serial console
brew "wakeonlan"
brew "nvie/tap/git-toolbelt", trusted: true

# --- CLI casks ---------------------------------------------------------------
# (1password-cli is installed via mise — see private_dot_config/mise/config.toml)

# --- Base GUI apps (official, self-updating casks) ---------------------------
cask "1password"
cask "alfred"
cask "dash"
cask "dbngin"
cask "google-chrome"
cask "hyperkey"
cask "logi-options-plus"
cask "rocket"
cask "slack"
cask "visual-studio-code"
cask "wireshark"
